{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tongzhou-member-card-local",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tongzhou-card-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "tongzhou-card-local"
    }
  ],
  "vars": {
    "ENVIRONMENT": "local"
  },
  "observability": {
    "enabled": false
  },
  "account_id": "90eee7dab6f8b0bcc8759cd0e402e033",
  "env": {
    "staging": {
      "name": "tongzhou-member-card-staging",
      "vars": {
        "ENVIRONMENT": "staging"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tongzhou-card-staging",
          "database_id": "9ade766b-c4f3-4a8a-852f-7c354bdd765a",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "tongzhou-card-staging"
        }
      ],
      "triggers": {
        "crons": [
          "17 19 * * *"
        ]
      },
      "limits": {
        "cpu_ms": 1000
      }
    },
    "production": {
      "name": "tongzhou-member-card",
      "vars": {
        "ENVIRONMENT": "production"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tongzhou-card-production",
          "database_id": "d13e2956-5d74-404a-b42d-cd5ff2b51126",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "tongzhou-card-production"
        }
      ],
      "triggers": {
        "crons": [
          "43 19 * * *"
        ]
      },
      "limits": {
        "cpu_ms": 1000
      }
    }
  }
}
