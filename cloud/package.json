{
  "name": "tongzhou-member-card-cloud",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server/runtime.ts",
    "dev:client": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && esbuild src/server/runtime.ts src/server/migrate.ts src/server/run-cleanup.ts --bundle --platform=node --packages=external --format=esm --outdir=build",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/server/migrate.ts",
    "start": "node build/runtime.js",
    "cleanup": "node build/run-cleanup.js",
    "test": "tsx --test tests/postgres/*.test.ts"
  },
  "dependencies": {
    "hono": "4.13.13",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  }
}
